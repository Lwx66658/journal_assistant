{
  "name": "journal-assistant",
  "version": "1.0.0",
  "description": "刊行 · 编辑出版工作台 - Cloudflare Workers 版本",
  "main": "src/index.js",
  "scripts": {
    "build": "node build.js",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:full": "node deploy.js",
    "tail": "wrangler tail",
    "kv:create": "wrangler kv:namespace create KV_STORE",
    "kv:preview": "wrangler kv:namespace create KV_STORE --preview",
    "kv:list": "wrangler kv:key list --namespace-id=YOUR_KV_ID",
    "kv:get": "wrangler kv:key get --namespace-id=YOUR_KV_ID",
    "login": "wrangler login",
    "whoami": "wrangler whoami",
    "test:local": "npm run build && wrangler dev --local",
    "publish": "npm run deploy"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "publishing",
    "journal"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "wrangler": "^3.80.0"
  }
}
