{
  "name": "journal-assistant",
  "version": "1.0.0",
  "description": "刊行 · 编辑出版工作台 - Cloudflare Workers 版本",
  "main": "src/index.js",
  "scripts": {
    "build": "node build.js",
    "deploy": "npm run build && wrangler deploy",
    "dev": "npm run build && wrangler dev",
    "db:init:local": "wrangler d1 execute journal_db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute journal_db --remote --file=./schema.sql",
    "test:smoke": "node tests/smoke.mjs"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "publishing",
    "journal"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "wrangler": "^3.80.0"
  }
}
